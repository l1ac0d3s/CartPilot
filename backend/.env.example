NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cartpilot
# Set to true for managed databases that require SSL from outside their network.
DATABASE_SSL=false
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173
# Where customers are sent back to after paying.
FRONTEND_URL=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=4000
# Leave empty to use the built-in demo payment gateway.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_TIMEOUT_MINUTES=30
